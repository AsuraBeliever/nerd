# Copiar a .env.local y completar con valores reales.
# .env.local NUNCA se commitea — el repositorio es público (ver docs/08-seguridad.md).
# Todos los valores de aquí son falsos, a propósito.

# --- Base de datos (Neon) — desde la Fase 1 ---
DATABASE_URL="postgresql://usuario:password@host.neon.tech/nerd?sslmode=require"

# --- Auth.js — desde la Fase 1 ---
# Generar con: openssl rand -base64 32
AUTH_SECRET="reemplazar-por-un-secreto-generado-al-azar"
AUTH_URL="http://localhost:3000"

# --- Google OAuth — desde la Fase 1 ---
# Se obtienen en Google Cloud Console → Credenciales → ID de cliente OAuth
AUTH_GOOGLE_ID="000000000000-ejemplo.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-ejemplo-no-real"

# --- Solo desarrollo ---
# Permite entrar sin Google mientras se configuran las credenciales de OAuth.
# Se ignora por completo en producción (NODE_ENV=production).
DEV_LOGIN="true"
